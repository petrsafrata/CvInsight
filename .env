# DB
POSTGRES_DB=testdb
POSTGRES_USER=test
POSTGRES_PASSWORD=test
DB_PORT=5432

# Spring profile
SPRING_PROFILES_ACTIVE=dev

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Release case
RELEASE_CACHE_TTL_MS=600000

# Server
TOMCAT_THREADS_MAX=200
TOMCAT_THREADS_MIN_SPARE=10
TOMCAT_MAX_CONNECTIONS=10000
TOMCAT_ACCEPT_COUNT=100
TOMCAT_CONNECTION_TIMEOUT=5s